# Optional FINAL stage in a private, trusted orchestrator after candidate validation,
# endurance, form review/signing and delivery preparation, or an explicitly approved
# request with disclosed gaps. Never run untrusted PR code here.
name: Deliver approved Crestron submission
on:
  workflow_call:
    inputs:
      enabled:
        type: boolean
        required: true
    secrets:
      submission_credentials_json:
        required: true
permissions:
  contents: read
concurrency:
  group: crestron-submission-protected-stages
  queue: max
  cancel-in-progress: false
jobs:
  deliver:
    if: ${{ inputs.enabled && vars.CRESTRON_SUBMISSION_STAGES_ENABLED == 'true' && vars.CRESTRON_SUBMISSION_RUNNER_LABEL != '' && vars.CRESTRON_SUBMISSION_REPOSITORY != '' && github.repository == vars.CRESTRON_SUBMISSION_REPOSITORY && vars.CRESTRON_SUBMISSION_BRANCH != '' && github.ref == format('refs/heads/{0}', vars.CRESTRON_SUBMISSION_BRANCH) && (github.event_name == 'workflow_dispatch' || github.event_name == 'release') }}
    environment: crestron-submission-delivery
    runs-on: [self-hosted, Windows, "${{ vars.CRESTRON_SUBMISSION_RUNNER_LABEL }}"]
    timeout-minutes: 50
    steps:
      # These environment variables must be approved independently of the producing worker.
      # Bundled console settings can be generated with submission-delivery-settings; see DeliverySetup.md.
      # Schema-2 settings already inventory ALL files in the complete console distribution.
      - name: Verify protected tooling and deliver the reviewed plan
        shell: pwsh
        env:
          DELIVERY_SETTINGS: ${{ vars.CRESTRON_SUBMISSION_DISPATCH_SETTINGS }}
          DELIVERY_SETTINGS_SHA256: ${{ vars.CRESTRON_SUBMISSION_DISPATCH_SETTINGS_SHA256 }}
          PRIVATE_DELIVERY_CREDENTIALS: ${{ secrets.submission_credentials_json }}
        run: |
          $ErrorActionPreference = 'Stop'
          if (-not [IO.Path]::IsPathFullyQualified($env:DELIVERY_SETTINGS) -or $env:DELIVERY_SETTINGS_SHA256 -cnotmatch '^[a-f0-9]{64}$') { throw 'Configure independently reviewed delivery settings.' }
          if ((Get-Item -LiteralPath $env:DELIVERY_SETTINGS).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Redirected settings are unsupported.' }
          $settingsBytes = [IO.File]::ReadAllBytes($env:DELIVERY_SETTINGS)
          if ($settingsBytes.Length -gt 1048576 -or [Convert]::ToHexString([Security.Cryptography.SHA256]::HashData($settingsBytes)).ToLowerInvariant() -cne $env:DELIVERY_SETTINGS_SHA256) { throw 'Reviewed settings changed.' }
          $settings = [Text.Encoding]::UTF8.GetString($settingsBytes) | ConvertFrom-Json
          if ($settings.schemaVersion -eq 2 -and $null -eq $settings.revalidation -and $null -ne $settings.bundledRevalidation) {
            $deliveryCommand = 'submission-deliver'
            $tooling = $settings.bundledRevalidation
          } elseif ($settings.schemaVersion -eq 1 -and $settings.plan.reviewMode -ceq 'DeclaredGaps' -and $null -ne $settings.tooling -and $null -eq $settings.revalidation -and $null -eq $settings.bundledRevalidation) {
            $deliveryCommand = 'submission-review-request-deliver'
            $tooling = $settings.tooling
          } else { throw 'Use independently approved complete-delivery or unsigned-request settings; see ReviewApproval.md.' }
          $manifest = @{ root = $tooling.consoleDirectory; entrypoint = 'CrestronHomeDevTools.Console.exe'; files = @($tooling.consoleFiles | ForEach-Object { @{ path = $_.relativePath; sha256 = $_.sha256 } }) }
          if (-not [IO.Path]::IsPathFullyQualified($manifest.root) -or -not (Test-Path -LiteralPath $manifest.root -PathType Container)) { throw 'Tooling installation is missing.' }
          $root = [IO.Path]::GetFullPath($manifest.root).TrimEnd('\') + '\'
          if ((Get-Item -LiteralPath $root).Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Redirected tooling is unsupported.' }
          $entries = @(Get-ChildItem -LiteralPath $root -Recurse -Force)
          if ($entries | Where-Object { $_.Attributes -band [IO.FileAttributes]::ReparsePoint }) { throw 'Redirected tooling is unsupported.' }
          $files = @($entries | Where-Object { -not $_.PSIsContainer })
          if ($files.Count -ne @($manifest.files).Count -or $files.Count -eq 0) { throw 'Tooling inventory changed.' }
          $seen = [Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
          foreach ($pin in $manifest.files) {
            if ([IO.Path]::IsPathRooted($pin.path) -or $pin.path -match '(^|[/\\])\.\.([/\\]|$)' -or $pin.sha256 -cnotmatch '^[a-f0-9]{64}$') { throw 'Invalid tooling pin.' }
            $path = [IO.Path]::GetFullPath((Join-Path $root $pin.path))
            if (-not $path.StartsWith($root,[StringComparison]::OrdinalIgnoreCase) -or -not $seen.Add($path) -or (Get-FileHash -LiteralPath $path -Algorithm SHA256).Hash.ToLowerInvariant() -cne $pin.sha256) { throw 'Tooling contents changed.' }
          }
          $exe = [IO.Path]::GetFullPath((Join-Path $root $manifest.entrypoint))
          if (-not $seen.Contains($exe) -or [IO.Path]::GetExtension($exe) -cne '.exe') { throw 'Pin the console executable.' }
          $credentials = $env:PRIVATE_DELIVERY_CREDENTIALS
          Remove-Item Env:\PRIVATE_DELIVERY_CREDENTIALS
          if ([string]::IsNullOrWhiteSpace($credentials)) { throw 'Private delivery credentials are unavailable.' }
          $start = [Diagnostics.ProcessStartInfo]::new($exe)
          $start.UseShellExecute = $false
          $start.CreateNoWindow = $true
          $start.RedirectStandardInput = $true
          $start.RedirectStandardOutput = $true
          $start.RedirectStandardError = $true
          $start.Environment.Remove('PRIVATE_DELIVERY_CREDENTIALS') | Out-Null
          foreach ($arg in @($deliveryCommand,'--settings',$env:DELIVERY_SETTINGS,'--settings-sha256',$env:DELIVERY_SETTINGS_SHA256,'--execute-approved')) { $start.ArgumentList.Add($arg) }
          $process = [Diagnostics.Process]::Start($start)
          try {
            $out = $process.StandardOutput.ReadToEndAsync()
            $err = $process.StandardError.ReadToEndAsync()
            $process.StandardInput.Write($credentials)
            $process.StandardInput.Close()
            $credentials = $null
            $process.WaitForExit()
            if ($process.ExitCode -ne 0) { throw 'Delivery stopped; inspect private receipts. Do not retry automatically.' }
            $result = $out.Result | ConvertFrom-Json
            if ($result.SchemaVersion -ne 1 -or $result.State -ne 'Submitted' -or $result.Submitted -ne $true) { throw 'No confirmed submission state.' }
            'The upload and email providers confirmed their operations. This does not establish inbox delivery or Crestron acceptance, publication or certification.' >> $env:GITHUB_STEP_SUMMARY
          } finally { $credentials = $null; $process.Dispose() }
