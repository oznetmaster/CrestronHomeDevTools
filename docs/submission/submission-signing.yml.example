# Private trusted orchestration only. Configure required reviewers on the named
# environment; this template does not create or enforce those settings itself.
name: Prepare authorized signed Crestron review
on:
  workflow_call:
    inputs:
      enabled:
        type: boolean
        required: true
      review_sha256:
        type: string
        required: true
      authorization_sha256:
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: crestron-submission-signing
  cancel-in-progress: false
jobs:
  sign-reviewed-form:
    if: ${{ inputs.enabled && (github.event_name == 'workflow_dispatch' || github.event_name == 'release') }}
    environment: crestron-submission-signing
    runs-on: [self-hosted, Windows, crestron-submission-signing]
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          repository: oznetmaster/CrestronHomeDevTools
          ref: REPLACE_WITH_AUDITED_FULL_TOOLING_COMMIT
          persist-credentials: false
      - name: Build the pinned offline validator
        shell: pwsh
        run: dotnet build CrestronHomeDevTools.Console/CrestronHomeDevTools.Console.csproj -c Release
      - name: Revalidate and prepare signed review privately
        shell: pwsh
        env:
          SIGNING_REVIEW: ${{ inputs.review_sha256 }}
          SIGNING_AUTHORIZATION: ${{ inputs.authorization_sha256 }}
        run: |
          if (-not $env:CRESTRON_SUBMISSION_SIGNING_SETTINGS) { throw 'Private signing settings are not configured.' }
          $settings = Get-Content -LiteralPath $env:CRESTRON_SUBMISSION_SIGNING_SETTINGS -Raw | ConvertFrom-Json
          $expectedValidator = Join-Path $PWD 'CrestronHomeDevTools.Console/bin/Release/net10.0/CrestronHomeDevTools.Console.dll'
          if ((Resolve-Path -LiteralPath $settings.validator).Path -ne (Resolve-Path -LiteralPath $expectedValidator).Path) { throw 'Private settings must select the validator built from the pinned tooling checkout.' }
          if ((Resolve-Path -LiteralPath $settings.dotnet).Path -ne (Get-Command dotnet).Source) { throw 'Private settings must select the build runtime.' }
          python tools/submission/prepare_signed_review.py --settings "$env:CRESTRON_SUBMISSION_SIGNING_SETTINGS" --review-sha256 "$env:SIGNING_REVIEW" --authorization-sha256 "$env:SIGNING_AUTHORIZATION"
          if ($LASTEXITCODE -ne 0) { throw 'Signed review preparation failed; no submission was sent.' }
          'Signed review prepared privately. Final visual review and separately authorized delivery remain pending.' >> $env:GITHUB_STEP_SUMMARY
