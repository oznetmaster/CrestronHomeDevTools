# Private trusted orchestration only. Configure required reviewers on the named
# environment; this template does not create or enforce those settings itself.
name: Prepare authorized signed Crestron review
on:
  workflow_call:
    inputs:
      enabled:
        type: boolean
        required: true
      review_sha256:
        type: string
        required: true
      authorization_sha256:
        type: string
        required: true
permissions:
  contents: read
concurrency:
  group: crestron-submission-protected-stages
  queue: max
  cancel-in-progress: false
jobs:
  sign-reviewed-form:
    if: ${{ inputs.enabled && vars.CRESTRON_SUBMISSION_STAGES_ENABLED == 'true' && vars.CRESTRON_SUBMISSION_RUNNER_LABEL != '' && vars.CRESTRON_SUBMISSION_REPOSITORY != '' && github.repository == vars.CRESTRON_SUBMISSION_REPOSITORY && vars.CRESTRON_SUBMISSION_BRANCH != '' && github.ref == format('refs/heads/{0}', vars.CRESTRON_SUBMISSION_BRANCH) && (github.event_name == 'workflow_dispatch' || github.event_name == 'release') }}
    environment: crestron-submission-signing
    runs-on: [self-hosted, Windows, "${{ vars.CRESTRON_SUBMISSION_RUNNER_LABEL }}"]
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          repository: oznetmaster/CrestronHomeDevTools
          ref: REPLACE_WITH_AUDITED_FULL_TOOLING_COMMIT
          persist-credentials: false
      - name: Build the pinned submission console
        shell: pwsh
        run: ./tools/BuildSubmissionConsole.ps1 -OutputDirectory artifacts/submission-console
      - name: Revalidate and prepare signed review privately
        shell: pwsh
        env:
          CRESTRON_SUBMISSION_SIGNING_SETTINGS: ${{ vars.CRESTRON_SUBMISSION_SIGNING_SETTINGS }}
          SIGNING_REVIEW: ${{ inputs.review_sha256 }}
          SIGNING_AUTHORIZATION: ${{ inputs.authorization_sha256 }}
        run: |
          if (-not $env:CRESTRON_SUBMISSION_SIGNING_SETTINGS) { throw 'Private signing settings are not configured.' }
          & ./artifacts/submission-console/CrestronHomeDevTools.Console.exe submission prepare-signed-review --settings "$env:CRESTRON_SUBMISSION_SIGNING_SETTINGS" --review-sha256 "$env:SIGNING_REVIEW" --authorization-sha256 "$env:SIGNING_AUTHORIZATION"
          if ($LASTEXITCODE -ne 0) { throw 'Signed review preparation failed; no submission was sent.' }
          'Signed review prepared privately. Final visual review and separately authorized delivery remain pending.' >> $env:GITHUB_STEP_SUMMARY
