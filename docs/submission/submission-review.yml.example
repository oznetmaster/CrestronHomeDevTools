# Copy only into a private trusted orchestration repository. Source template,
# not an enabled workflow. Replace the tooling commit before use.
name: Prepare unsigned Crestron submission review
on:
  workflow_call:
    inputs:
      enabled:
        type: boolean
        required: true
      prepare_for_signing:
        description: Prepare an unsigned signing copy; does not authorize a signature or delivery
        type: boolean
        default: false
      review_mode:
        description: complete or declared-gaps; neither implies Crestron acceptance
        type: string
        default: complete
      declarations_sha256:
        description: Independent digest of candidate-bound gap explanations; required only for declared-gaps
        type: string
        default: ''
      artifact_kind:
        type: string
        required: true
      source_commit:
        type: string
        required: true
      candidate_sha256:
        type: string
        required: true
      inventory_sha256:
        type: string
        required: true
      mapping_sha256:
        type: string
        required: true
      android_pins_sha256:
        description: Independent pre-execution Android pins digest; required for supplied Android observations
        type: string
        default: ''
permissions:
  contents: read
concurrency:
  group: crestron-submission-protected-stages
  queue: max
  cancel-in-progress: false
jobs:
  prepare-review:
    if: ${{ inputs.enabled && vars.CRESTRON_SUBMISSION_STAGES_ENABLED == 'true' && vars.CRESTRON_SUBMISSION_RUNNER_LABEL != '' && vars.CRESTRON_SUBMISSION_REPOSITORY != '' && github.repository == vars.CRESTRON_SUBMISSION_REPOSITORY && vars.CRESTRON_SUBMISSION_BRANCH != '' && github.ref == format('refs/heads/{0}', vars.CRESTRON_SUBMISSION_BRANCH) && (github.event_name == 'workflow_dispatch' || github.event_name == 'release') }}
    environment: crestron-submission-review
    runs-on: [self-hosted, Windows, "${{ vars.CRESTRON_SUBMISSION_RUNNER_LABEL }}"]
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
        with:
          repository: oznetmaster/CrestronHomeDevTools
          ref: REPLACE_WITH_AUDITED_FULL_TOOLING_COMMIT
          persist-credentials: false
      - name: Build the pinned submission console
        shell: pwsh
        run: ./tools/BuildSubmissionConsole.ps1 -OutputDirectory artifacts/submission-console
      - name: Prepare private unsigned review
        shell: pwsh
        env:
          CRESTRON_SUBMISSION_REVIEW_SETTINGS: ${{ vars.CRESTRON_SUBMISSION_REVIEW_SETTINGS }}
          CRESTRON_SUBMISSION_ANDROID_PINS: ${{ vars.CRESTRON_SUBMISSION_ANDROID_PINS }}
          CRESTRON_SUBMISSION_DECLARATIONS: ${{ vars.CRESTRON_SUBMISSION_DECLARATIONS }}
          REVIEW_KIND: ${{ inputs.artifact_kind }}
          REVIEW_SOURCE: ${{ inputs.source_commit }}
          REVIEW_CANDIDATE: ${{ inputs.candidate_sha256 }}
          REVIEW_INVENTORY: ${{ inputs.inventory_sha256 }}
          REVIEW_MAPPING: ${{ inputs.mapping_sha256 }}
          REVIEW_SIGNING_COPY: ${{ inputs.prepare_for_signing }}
          REVIEW_ANDROID_PINS: ${{ inputs.android_pins_sha256 }}
          REVIEW_MODE: ${{ inputs.review_mode }}
          REVIEW_DECLARATIONS: ${{ inputs.declarations_sha256 }}
        run: |
          if (-not $env:CRESTRON_SUBMISSION_REVIEW_SETTINGS) { throw 'Private review settings are not configured.' }
          if ($env:REVIEW_MODE -notin @('complete', 'declared-gaps')) { throw 'Unsupported review mode.' }
          $reviewOptions = @('--review-mode', $env:REVIEW_MODE)
          if ($env:REVIEW_MODE -eq 'declared-gaps') {
            if (-not $env:CRESTRON_SUBMISSION_DECLARATIONS -or -not $env:REVIEW_DECLARATIONS) { throw 'Independently pinned gap declarations are required.' }
            $reviewOptions += @('--declarations', $env:CRESTRON_SUBMISSION_DECLARATIONS, '--declarations-sha256', $env:REVIEW_DECLARATIONS)
          } elseif ($env:REVIEW_DECLARATIONS) { throw 'Gap declarations require explicit declared-gaps mode.' }
          if ($env:REVIEW_SIGNING_COPY -eq 'true') { $reviewOptions += '--prepare-for-signing' }
          if ($env:REVIEW_ANDROID_PINS) {
            if (-not $env:CRESTRON_SUBMISSION_ANDROID_PINS) { throw 'Independent Android pins are not configured.' }
            $reviewOptions += @('--android-pins', $env:CRESTRON_SUBMISSION_ANDROID_PINS, '--android-pins-sha256', $env:REVIEW_ANDROID_PINS)
          }
          & ./artifacts/submission-console/CrestronHomeDevTools.Console.exe submission prepare-review --settings "$env:CRESTRON_SUBMISSION_REVIEW_SETTINGS" --artifact-kind "$env:REVIEW_KIND" --source-commit "$env:REVIEW_SOURCE" --candidate-sha256 "$env:REVIEW_CANDIDATE" --inventory-sha256 "$env:REVIEW_INVENTORY" --mapping-sha256 "$env:REVIEW_MAPPING" @reviewOptions
          if ($LASTEXITCODE -ne 0) { throw 'Unsigned review preparation failed; no submission was sent.' }
          'Unsigned review prepared privately. Inspect its verification status; successful preparation does not mean every requirement passed. Signing, delivery and any Crestron decision remain separate.' >> $env:GITHUB_STEP_SUMMARY
