<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CrestronHomeDevTools</PackageId>
    <Description>Unofficial Crestron Home configuration management client for development tools.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Crestron;CrestronHome;configuration;drivers</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../licenses/*.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../RELEASE-NOTES.md;../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../docs/**/*" Pack="true" PackagePath="docs/%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <InternalsVisibleTo Include="CrestronHomeDevTools.Tests" />
  </ItemGroup>
</Project>